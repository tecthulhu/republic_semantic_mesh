# --- Generated truth (ONT-016: the index is regenerable, never source) ---
# Derived only: embedding vectors and standing-query reports. Losing this
# directory loses nothing — it rebuilds from the corpus.
index/
*.embeddings.json
standing_queries.json

# NOT ignored, deliberately: platform/acta/ (D17 / SPEC-0106). Evidence rows are
# records, not derivations — true-at-T, born once, never regenerable (ONT-014/046).
# A record that lives only in an ignored directory or an expiring CI artifact is
# provenance with a countdown timer. Interim until the data-access citizen's
# durable consumer exists (PA-007), then retired by decision.

# --- Secrets & credential material (never committed; handoff is runtime-mounted per L0-011) ---
*.cred
*.token
*.seed
*.nk
*.pem
*.key
# Developer tokens live outside the repository; these patterns exist so a stray
# copy inside it is un-committable rather than merely discouraged.
*_token
*_developer_token
*_api_key
*api_key*
.tecthulhu_*
.republic_*
.env
.env.*
!.env.example
/run/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (Rostra / tooling, when it arrives) ---
node_modules/
dist/
.npm/
*.tsbuildinfo

# --- Containers & build output ---
*.tar
*.oci
.build/
out/

# --- Local scratch (agents work in-container; host scratch is never truth) ---
/work/
/tmp-*/
*.log

# --- Editors & OS noise ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Claude Code local state (project settings are shared; local overrides are not) ---
.claude/settings.local.json

# A6/A7 — machine bindings. The repo carries structure; machines carry bindings.
platform/tools/providers.local.json
platform/tools/hosts.denylist
